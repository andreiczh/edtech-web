# GoSpeak — переменные окружения бэкенда. Скопируй в backend/.env и подставь
# ключ; .env в git не попадает (см. .gitignore). Здесь ВСЕ переменные, которые
# читает код (сверено с backend/*.py 26.09.2026). Обязательна одна: LLM_API_KEY.
# Значение после «=» — дефолт из кода, если в комментарии не сказано иное.

# ============================================================ ОБЯЗАТЕЛЬНОЕ
# Mistral — единственный провайдер, который работает из РФ без VPN и без карты
# (проверено 17.07.2026). Ключ: console.mistral.ai -> API Keys. Один ключ на
# LLM, распознавание (Voxtral) и озвучку (voxtral-mini-tts).
LLM_API_KEY=вставь_сюда_ключ_mistral

# ============================================================ LLM
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
# Запасная модель на 10 минут, если у ключа лимит 0 на основную (22.09.2026:
# Mistral отдаёт 429 с лимитом 0 на small/medium). Видно в /health.llm_fallback.
LLM_FALLBACK_MODEL=ministral-8b-latest
# Месячный самоограничитель вызовов LLM: с 80 % и опережения календаря —
# экономия, на 100 % — стоп. Видно в /health.budget_month.
MONTHLY_LLM_BUDGET=30000
# Температура разборов (0 = детерминированно, как у экспертов).
GRADE_TEMPERATURE=0
# Монолог №42: второй проход и консенсус двух проходов.
MONOLOGUE_RECHECK=0
MONO_CONSENSUS=1
# Модель для чтения картинок при импорте банка ФИПИ (/admin/fipi/import).
FIPI_VISION_MODEL=mistral-medium-latest

# ============================================================ РАСПОЗНАВАНИЕ (STT)
# mistral (по сети, ~99 МБ памяти) или local (faster-whisper: ~1 ГБ и настоящий CPU).
STT_PROVIDER=mistral
STT_REMOTE_MODEL=voxtral-mini-latest
# Точная модель ТОЛЬКО для оцениваемых заданий 39–42. Дефолт в коде — пусто
# (везде одна модель); на проде стоит voxtral-small-latest.
STT_TASK_MODEL=voxtral-small-latest
STT_TIMEOUT=12
STT_TASK_TIMEOUT=40
STT_LANGUAGE=en
# 1 = при сбое Mistral откатываться на локальный whisper. На хостинге с 512 МБ
# ставить 0: одна битая запись поднимет модель и уронит процесс по памяти.
STT_FALLBACK_LOCAL=1
# Локальный whisper (STT_PROVIDER=local или запасной путь); веса качаются при
# первом запросе (~150 МБ). WHISPER_MODEL — задания, WHISPER_MODEL_FAST — разговор.
WHISPER_MODEL=base.en
WHISPER_MODEL_FAST=tiny.en

# ============================================================ ОЗВУЧКА (TTS)
# mistral (эмоция в голосе, диктор один) или edge (edge-tts без ключа, три голоса).
TTS_PROVIDER=mistral
TTS_REMOTE_MODEL=voxtral-mini-tts-latest
TTS_REMOTE_VOICE=en_paul_neutral
# Голос edge-tts (полный список: `edge-tts --list-voices`).
TTS_VOICE=en-US-AvaMultilingualNeural
# Одно и то же слово с одного устройства озвучивать не чаще раза в N секунд (/speak).
TTS_COOLDOWN_SEC=120

# ============================================================ БАЗА И ДОСТУП
# Пусто = SQLite-файл backend/pingo.db. Postgres (Neon):
# postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Ключ админки (/admin/*, заголовок X-Admin-Key). Длинная случайная строка.
ADMIN_KEY=
# 1 = маршруты ученика требуют аккаунт (X-Device = id из /auth/*). 0 — только отладка.
REQUIRE_ACCOUNT=1
# Регистрация по коду доступа. 0 (по умолчанию, с 27.09.2026) — регистрация
# открыта, код не спрашивается. 1 — нужен код: из админки (/admin/invites)
# или из INVITE_CODES; нет ни одного кода — регистрация закрыта (fail-closed).
INVITE_REQUIRED=0
# Коды через запятую — «первый ключ» для пустой базы, работают только при
# INVITE_REQUIRED=1.
INVITE_CODES=
# Ключ разметчика для экрана сверки монологов (/label42/*). Пусто = выключено.
LABELER_KEY=
# Кэш банка заданий /tasks, секунд (Neon не будится на каждый заход).
TASKS_CACHE_SEC=600

# ============================================================ MAX (мессенджер)
# Токен бота из платформы MAX для партнёров (business.max.ru). Пусто = вход
# через MAX выключен (/auth/max → 503) и вебхук /max/webhook → 503.
MAX_BOT_TOKEN=
# Соль для id MAX-аккаунтов. Задать ДО первых входов и больше не менять:
# сменится — у всех MAX-аккаунтов выведутся новые id и пропадёт прогресс.
# Пусто = встроенная константа, и тогда id угадываем по номеру пользователя
# MAX (видно в /health.max_bot.id_salt_set).
MAX_ID_SALT=
# Адрес мини-приложения для кнопки в приветствии бота. Пусто = адрес сервера.
MAX_APP_URL=
# Имя бота для кнопки open_app. Пусто = берётся из GET /me по токену.
MAX_BOT_USERNAME=
# 1 = адрес мини-приложения привязан к боту в платформе MAX для партнёров:
# бот шлёт кнопку мини-приложения. 0 (по умолчанию) — только личную ссылку
# со входом без регистрации (#mlogin=..., §6.50): open_app без привязки не работает.
MAX_MINIAPP_READY=0
# 0 = новые аккаунты через MAX не создаются (аварийный тормоз).
MAX_SIGNUP=1
# 0 = страница-проба /max-check и её ручки выключены.
MAX_PROBE=1

# ============================================================ ХОСТИНГ
# Самопинг, чтобы бесплатный Render не засыпал: адрес своего сервиса и окно
# по UTC. Пусто = выключено (локально не нужен).
KEEP_AWAKE_URL=
KEEP_AWAKE_FROM_HOUR_UTC=4
KEEP_AWAKE_TO_HOUR_UTC=20
# Слать запросы к Mistral/edge-tts мимо VPN, привязав сокеты к IPv4
# физического интерфейса (Wi-Fi, НЕ VPN-адаптера). Пусто = маршрут по умолчанию.
OUTBOUND_LOCAL_IP=
# 1 = не сбрасывать системный прокси для исходящих запросов.
KEEP_SYSTEM_PROXY=
# Алерты владельцу в Telegram (/admin/notify, провал бэкапа). Пусто = выключено.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================ ЗАМЕРЫ РЕЧИ (фон)
# Подача чтения (темп, заминки): 1 = включено (нужен процессор), пусто = выключено.
DELIVERY_ANALYSIS=
DELIVERY_MODEL=tiny.en
# Произношение (GOP): числа копятся фоном, ученику не показываются (PRON_SHOW=0).
PRON_COLLECT=1
PRON_SHOW=0
PRON_MIN_WORDS=6
PRON_BUDGET_SEC=90
PRON_TALK_EVERY=4
GOP_MODEL=base.en
# Корпус голоса (только с согласия ученика): лимиты на запись и на человека.
CORPUS_COLLECT=1
CORPUS_MAX_SEC=180
CORPUS_MAX_MB=150
CORPUS_PER_STUDENT=40
CORPUS_PER_STUDENT_KIND=15

# ============================================================ СЛУЖЕБНОЕ (скрипты, не сервер)
# backup.py / restore.py / test_*_live.py ходят на прод этими переменными.
PINGO_BASE_URL=https://pingo-ai-dpd9.onrender.com
PINGO_ADMIN_KEY=
GRID_BASE_URL=http://127.0.0.1:8000
GOLDEN_BASE=http://127.0.0.1:8046
GOLDEN_KEY=golden-check
