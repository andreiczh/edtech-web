# Скопируй в .env и подставь ключ. .env в git не попадёт (см. .gitignore).
# Нужен ТОЛЬКО ОДИН ключ — LLM. STT и TTS работают без ключей.

# LLM — Mistral. ЕДИНСТВЕННЫЙ провайдер, который реально работает из РФ без VPN
# и активируется без карты. Проверено на практике 17.07.2026.
# Ключ: console.mistral.ai -> API Keys -> Create new key.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=вставь_сюда_ключ_mistral
LLM_MODEL=mistral-small-latest

# --- Ниже менять не обязательно, дефолты рабочие ---

# STT — faster-whisper локально (без ключа). Модель качается 1 раз при старте
# сервера (~150 МБ, без индикатора прогресса — это нормально, ждать).
# base.en = легче/быстрее (только англ.); small = точнее, но тяжело для слабого ноута.
WHISPER_MODEL=base.en

# TTS — edge-tts (без ключа). Другие голоса: en-US-JennyNeural, en-US-GuyNeural,
# en-GB-SoniaNeural. Полный список: `edge-tts --list-voices`.
TTS_VOICE=en-US-AriaNeural

# ============================================================================
# НЕ РАБОТАЮЩИЕ ИЗ РФ ВАРИАНТЫ — оставлены, чтобы не перебирать их заново.
# Каждый проверен на практике, не по статьям.
#
#   DeepSeek       — API доступен, но бесплатный грант не начисляется:
#                    402 Insufficient Balance. Нужна карта не РФ.
#     LLM_BASE_URL=https://api.deepseek.com
#     LLM_MODEL=deepseek-chat
#
#   OpenRouter     — Cloudflare-блок РФ: "Sorry, you are blocked" прямо в браузере,
#                    до всякого API-запроса. Статьи об обратном врут.
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   Groq / OpenAI / Gemini / xAI — экспортный контроль США, заблокированы.
# ============================================================================
