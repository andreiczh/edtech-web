# Скопируй в .env и подставь ключ. .env в git не попадёт (см. .gitignore).
# Нужен ТОЛЬКО ОДИН ключ — OpenRouter (STT и TTS работают без ключей).

# LLM — OpenRouter :free-модели. Из РФ без VPN, карта НЕ нужна для :free.
# Ключ: openrouter.ai → зарегистрируйся → Keys → Create Key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxx
# Актуальный список бесплатных моделей (лайнап меняется):
#   https://openrouter.ai/models?max_price=0  → возьми любую с суффиксом :free
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Ниже менять не обязательно, дефолты рабочие ---

# STT — faster-whisper локально (без ключа). Модель качается 1 раз при старте.
# base.en=легче/быстрее (англ.), small.en=точнее, small=мультиязычная/тяжелее.
WHISPER_MODEL=base.en

# TTS — edge-tts (без ключа). Голоса: en-US-AriaNeural, en-US-JennyNeural,
# en-US-GuyNeural, en-GB-SoniaNeural. Список: `edge-tts --list-voices`.
TTS_VOICE=en-US-AriaNeural

# Альтернатива LLM, если упрёшься в лимит OpenRouter (~50 запросов/день):
# DeepSeek — из РФ без VPN, 5M токенов бесплатно при регистрации без карты.
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-...        (ключ из platform.deepseek.com)
#   LLM_MODEL=deepseek-chat
