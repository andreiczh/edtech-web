# Скопируй в .env и подставь ключ. .env в git не попадёт (см. .gitignore).
# Нужен ТОЛЬКО ОДИН ключ — LLM (STT и TTS работают без ключей).

# LLM — DeepSeek. Подтверждённо работает из РФ БЕЗ VPN (проверено на практике).
# Регистрация: platform.deepseek.com → API keys → Create new key.
# 5M токенов бесплатно на аккаунт, дальше — платно (карта не РФ, см. Habr-статьи
# про оплату DeepSeek из РФ, если понадобится пополнение).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# --- Ниже менять не обязательно, дефолты рабочие ---

# STT — faster-whisper локально (без ключа). Модель качается 1 раз при старте.
# base.en=легче/быстрее (англ.), small.en=точнее, small=мультиязычная/тяжелее.
WHISPER_MODEL=base.en

# TTS — edge-tts (без ключа). Голоса: en-US-AriaNeural, en-US-JennyNeural,
# en-US-GuyNeural, en-GB-SoniaNeural. Список: `edge-tts --list-voices`.
TTS_VOICE=en-US-AriaNeural

# Альтернатива LLM — OpenRouter :free-модели (карта не нужна, лимит ~50 запр/день).
# ⚠️ НА ПРАКТИКЕ у части РФ-провайдеров openrouter.ai блокируется Cloudflare'ом
# ("Sorry, you are blocked" даже в обычном браузере, до всякого API-запроса) —
# перед использованием открой https://openrouter.ai в браузере и проверь, что
# страница вообще грузится. Если блокирует — DeepSeek выше, других вариантов нет.
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
