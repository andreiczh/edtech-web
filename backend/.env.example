# Скопируй в .env и подставь ключ. .env в git не попадёт (см. .gitignore).
# Нужен ТОЛЬКО ОДИН ключ — LLM. STT и TTS работают без ключей.

# LLM — Mistral. ЕДИНСТВЕННЫЙ провайдер, который реально работает из РФ без VPN
# и активируется без карты. Проверено на практике 17.07.2026.
# Ключ: console.mistral.ai -> API Keys -> Create new key.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=вставь_сюда_ключ_mistral
LLM_MODEL=mistral-small-latest

# --- Ниже менять не обязательно, дефолты рабочие ---

# Откуда берётся распознавание речи: mistral (по сети) или local (faster-whisper).
# Замер 22.07.2026, одно аудио: Mistral 0.54 с на реплике и 1.22 с на монологе;
# локально tiny.en 1.5 с и 7-10 с, base.en 3.2 с и 13-17 с. Точность на реплике
# одинаковая, 100%.
#
# Дело не только в скорости: whisper — единственная причина, по которой бэкенду
# нужны ~700 МБ-1 ГБ памяти и настоящий процессор, а бесплатные хостинги дают
# 512 МБ и 0.1 vCPU. С mistral процесс занимает ~99 МБ и влезает куда угодно.
# Локальный whisper остаётся запасным путём и работает без интернета.
STT_PROVIDER=mistral
STT_REMOTE_MODEL=voxtral-mini-latest

# STT — faster-whisper локально (без ключа). Нужен только при STT_PROVIDER=local
# или как запасной путь. Модель качается 1 раз при старте сервера (~150 МБ, без
# индикатора прогресса — это нормально, ждать).
# base.en = легче/быстрее (только англ.); small = точнее, но тяжело для слабого ноута.
#
# Моделей ДВЕ, по одной на режим (замер 22.07.2026, реплика 10 с):
#   WHISPER_MODEL      — монолог ЕГЭ, точность важнее: base.en, 3.2 с
#   WHISPER_MODEL_FAST — живой разговор, скорость важнее: tiny.en, 1.5 с
# Если разговор начнёт «недослышивать» на твоём акценте — поставь сюда base.en.
WHISPER_MODEL=base.en
WHISPER_MODEL_FAST=tiny.en

# Отправлять запросы к Mistral и edge-tts МИМО VPN, привязав сокеты к физическому
# интерфейсу. Оба провайдера работают из РФ без VPN, а крюк через туннель стоит
# дорого: замер 22.07.2026 — LLM 4.76 с через туннель против 0.34 с напрямую,
# TTS 1.71 против 0.42, и разброс мимо туннеля исчезает совсем.
#
# Значение — IPv4 ФИЗИЧЕСКОГО интерфейса (Wi-Fi/Ethernet), НЕ адрес VPN-адаптера.
# Узнать:  Get-NetIPAddress -AddressFamily IPv4
# Внимание: адрес меняется при смене сети/DHCP. Сервер проверяет его на старте и,
# если адрес исчез, честно откатывается к обычной маршрутизации с сообщением.
# Пусто — работать через маршрут по умолчанию (то есть через VPN).
OUTBOUND_LOCAL_IP=

# TTS — edge-tts (без ключа). Другие голоса: en-US-JennyNeural, en-US-GuyNeural,
# en-GB-SoniaNeural. Полный список: `edge-tts --list-voices`.
TTS_VOICE=en-US-AriaNeural

# ============================================================================
# НЕ РАБОТАЮЩИЕ ИЗ РФ ВАРИАНТЫ — оставлены, чтобы не перебирать их заново.
# Каждый проверен на практике, не по статьям.
#
#   DeepSeek       — API доступен, но бесплатный грант не начисляется:
#                    402 Insufficient Balance. Нужна карта не РФ.
#     LLM_BASE_URL=https://api.deepseek.com
#     LLM_MODEL=deepseek-chat
#
#   OpenRouter     — Cloudflare-блок РФ: "Sorry, you are blocked" прямо в браузере,
#                    до всякого API-запроса. Статьи об обратном врут.
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   Groq / OpenAI / Gemini / xAI — экспортный контроль США, заблокированы.
# ============================================================================
