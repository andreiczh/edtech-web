# Скопируй в .env и подставь свои ключи. .env в git не попадёт (см. .gitignore).

# STT — Groq (console.groq.com → API Keys). Бесплатный tier 3000 мин/мес.
GROQ_API_KEY=gsk_xxx

# LLM — provod.ai (оплата рублями). base URL и точное имя модели — в кабинете provod.ai.
PROVOD_BASE_URL=https://api.provod.ai/v1
PROVOD_API_KEY=xxx
LLM_MODEL=gemini-2.5-flash-lite
