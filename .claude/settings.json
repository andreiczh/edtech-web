{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm.cmd install:*)",
      "Bash(npm.cmd run build:*)",
      "Bash(npm.cmd run dev:*)",
      "Bash(ssh -o StrictHostKeyChecking=accept-new -R:*)",
      "Bash(ssh -p 443 -R:*)",
      "Bash(npx localtunnel:*)",
      "Bash(cloudflared tunnel --url http://127.0.0.1:8000:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)"
    ]
  }
}
